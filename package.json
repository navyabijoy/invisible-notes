{
  "name": "invisible-notes",
  "version": "1.2.0",
  "description": "Ghost Notes: translucent sticky notes that stay invisible to screen sharing and recording.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "Navya Bijoy",
  "license": "MIT",
  "homepage": "https://github.com/navyabijoy/invisible-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/navyabijoy/invisible-notes.git"
  },
  "bugs": {
    "url": "https://github.com/navyabijoy/invisible-notes/issues"
  },
  "keywords": [
    "sticky-notes",
    "notes",
    "electron",
    "screen-sharing",
    "privacy",
    "menubar",
    "overlay"
  ],
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.invisiblenotes.app",
    "productName": "Ghost Notes",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "note.html",
      "note.js",
      "store.js",
      "platform.js",
      "noteWindow.js",
      "displayUtils.js",
      "shortcuts.js",
      "manager.js",
      "manager-preload.js",
      "manager.html",
      "manager-renderer.js",
      "build/tray-icon.png",
      "build/tray-icon@2x.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ghost Notes"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
